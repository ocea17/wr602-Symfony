{% extends 'base.html.twig' %}

{% block title %}Bienvenue - PDF Generator{% endblock %}

{% block body %}
{# Header #}
<header class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
            {# Logo #}
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-white fill-currentColor" viewBox="0 0 24 24">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                    </svg>
                </div>
                <span class="text-lg font-bold text-gray-900">PDF Generator</span>
            </div>

            {# Boutons connexion/inscription #}
            <div class="flex items-center gap-4">
                <a href="{{ path('app_login') }}" class="text-gray-600 hover:text-blue-500 font-medium transition">
                    Se connecter
                </a>
                <a href="{{ path('app_register') }}" class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">
                    Créer un compte
                </a>
            </div>
        </div>
    </div>
</header>

{# Hero #}
<div class="bg-gradient-to-br from-blue-500 to-purple-600 text-white py-20">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-5xl font-bold mb-6">Générez vos PDF facilement</h1>
        <p class="text-xl text-blue-100 mb-8">Convertissez vos documents en PDF en quelques clics. Choisissez le plan qui vous convient.</p>
    </div>
</div>

    {{ include('_partials/_plans_section.html.twig', {
        plans: plans,
        is_logged_in: false
    }) }}
{% endblock %}
