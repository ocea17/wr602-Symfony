{% extends 'base.html.twig' %}

{% block title %}Bienvenue - PDF Generator{% endblock %}

{% block body %}
{# Header simple pour visiteurs #}
<header class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
            {# Logo #}
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 bg-blue-500 rounded-lg flex items-center justify-center">
                    <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z"/>
                    </svg>
                </div>
                <span class="text-lg font-bold text-gray-900">PDF Generator</span>
            </div>

            {# Boutons connexion/inscription #}
            <div class="flex items-center gap-4">
                <a href="{{ path('app_login') }}" class="text-gray-600 hover:text-blue-500 font-medium transition">
                    Se connecter
                </a>
                <a href="{{ path('app_register') }}" class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white font-medium rounded-lg transition">
                    Créer un compte
                </a>
            </div>
        </div>
    </div>
</header>

{# Hero section #}
<div class="bg-gradient-to-br from-blue-500 to-purple-600 text-white py-20">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <h1 class="text-5xl font-bold mb-6">Générez vos PDF facilement</h1>
        <p class="text-xl text-blue-100 mb-8">Convertissez vos documents en PDF en quelques clics. Choisissez le plan qui vous convient.</p>
    </div>
</div>

{# Plans section #}
<div class="bg-gray-50 py-16">
    <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl font-bold text-center text-gray-900 mb-12">Nos offres</h2>

        {# Plans grid #}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {% for plan in plans %}
                <div class="bg-white rounded-2xl border-2 border-gray-200 p-8 relative transition transform hover:-translate-y-2 hover:shadow-xl">
                    
                    {# Badge recommandé pour PREMIUM #}
                    {% if plan.name == 'PREMIUM' %}
                        <div class="absolute -top-3 right-6 bg-purple-500 text-white px-3 py-1 rounded-full text-xs font-semibold">
                            RECOMMANDÉ
                        </div>
                    {% endif %}

                    {# Badge du nom du plan #}
                    <span class="inline-block px-3 py-1 rounded-md text-sm font-semibold mb-4
                        {% if plan.name == 'FREE' %}bg-gray-100 text-gray-700
                        {% elseif plan.name == 'BASIC' %}bg-blue-100 text-blue-600
                        {% else %}bg-purple-100 text-purple-600{% endif %}">
                        {{ plan.name }}
                    </span>

                    {# Prix #}
                    <div class="mb-6">
                        <span class="text-5xl font-bold text-gray-900">
                            {% if plan.price == 0 %}
                                0€
                            {% else %}
                                {{ plan.price }}€
                            {% endif %}
                        </span>
                        <span class="text-lg text-gray-500">/mois</span>
                    </div>

                    {# Description #}
                    <p class="text-gray-600 mb-6">{{ plan.description }}</p>

                    {# Features #}
                    <ul class="space-y-3 mb-8">
                        <li class="flex items-center gap-2 text-gray-700">
                            <span class="text-green-500 font-bold">✓</span>
                            <span>
                                {% if plan.limitGeneration is null %}
                                    PDFs illimités
                                {% else %}
                                    {{ plan.limitGeneration }} PDFs par jour
                                {% endif %}
                            </span>
                        </li>
                        <li class="flex items-center gap-2 text-gray-700">
                            <span class="text-green-500 font-bold">✓</span>
                            <span>
                                {% if plan.name == 'FREE' %}
                                    Stockage 7 jours
                                {% elseif plan.name == 'BASIC' %}
                                    Stockage 30 jours
                                {% else %}
                                    Stockage illimité
                                {% endif %}
                            </span>
                        </li>
                        <li class="flex items-center gap-2 text-gray-700">
                            <span class="text-green-500 font-bold">✓</span>
                            <span>Tous les formats</span>
                        </li>
                        {% if plan.name == 'PREMIUM' %}
                            <li class="flex items-center gap-2 text-gray-700">
                                <span class="text-green-500 font-bold">✓</span>
                                <span>Sans watermark</span>
                            </li>
                            <li class="flex items-center gap-2 text-gray-700">
                                <span class="text-green-500 font-bold">✓</span>
                                <span>Accès API</span>
                            </li>
                        {% endif %}
                    </ul>

                    {# Button - Toujours vers login pour les visiteurs #}
                    <a href="{{ path('app_login') }}" class="block w-full py-3 px-6 text-center rounded-lg font-semibold transition transform hover:scale-105
                        {% if plan.name == 'PREMIUM' %}
                            bg-purple-500 hover:bg-purple-600 text-white
                        {% else %}
                            bg-blue-500 hover:bg-blue-600 text-white
                        {% endif %}">
                        Choisir ce plan
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{# Footer simple #}
<footer class="bg-gray-900 text-gray-400 py-8">
    <div class="max-w-7xl mx-auto px-6 text-center">
        <p>&copy; 2026 PDF Generator. Tous droits réservés.</p>
    </div>
</footer>
{% endblock %}
