{% extends 'base.html.twig' %}

{% block title %}Dashboard - PDF Generator{% endblock %}

{% block body %}
    {# Main content #}
    <div class="min-h-screen bg-gradient-to-br from-gray-50 to-blue-50 py-6 sm:py-10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            {# section bienvenue #}
            <div class="mb-6 sm:mb-10">
                <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-2 sm:mb-3">
                    Bonjour {{ app.user.firstname }} !
                </h1>
                {# Badge #}
                <div class="flex items-center gap-3">
                    <span class="inline-block px-3 py-1 rounded-md text-xs sm:text-sm font-semibold
                        {% if app.user.plan.name == 'FREE' %}bg-gray-100 text-gray-700
                        {% elseif app.user.plan.name == 'BASIC' %}bg-blue-100 text-blue-600
                        {% else %}bg-purple-100 text-purple-600{% endif %}">
                        {{ app.user.plan.name }}
                    </span>
                    {% if app.user.plan.name != 'PREMIUM' %}
                        <a href="{{ path('app_subscription_change') }}" class="text-xs sm:text-sm text-blue-600 hover:underline font-medium">
                            Améliorer mon plan
                        </a>
                    {% endif %}
                </div>
            </div>

            {# Stats grid - responsive #}
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mb-8 sm:mb-10">
                {# Stat 1 - nombre de pdf aujourd'hui #}
                <div class="bg-white border-2 border-blue-200 p-5 sm:p-6 rounded-xl shadow-sm hover:shadow-md transition">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                            <i data-lucide="zap" class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600"></i>
                        </div>
                        <div>
                            <div class="text-2xl sm:text-3xl font-bold {{ today_pdfs >= (app.user.plan.limitGeneration ?? 999) ? 'text-red-600' : 'text-blue-600' }}">
                                {{ today_pdfs }}/{{ app.user.plan.limitGeneration }}
                            </div>
                            <div class="text-sm sm:text-base text-gray-600">PDFs aujourd'hui</div>
                        </div>
                    </div>

                    {# Si la limite est atteinte #}
                    {% if today_pdfs >= (app.user.plan.limitGeneration ?? 999) %}
                        <div class="mt-3 p-2 bg-red-50 border border-red-200 rounded-lg">
                            <div class="flex items-center gap-2">
                                <i data-lucide="alert-circle" class="w-4 h-4 text-red-600"></i>
                                <span class="text-xs font-semibold text-red-600">LIMITE ATTEINTE</span>
                            </div>
                        </div>
                    {% endif %}
                </div>

                {# Stat 2 - total de pdf généré #}
                <div class="bg-white border-2 border-purple-200 p-5 sm:p-6 rounded-xl shadow-sm hover:shadow-md transition">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-purple-100 rounded-lg flex items-center justify-center">
                            <i data-lucide="file-text" class="w-5 h-5 sm:w-6 sm:h-6 text-purple-600"></i>
                        </div>
                        <div>
                            <div class="text-2xl sm:text-3xl font-bold text-purple-600">
                                {{ total_pdfs }}
                            </div>
                            <div class="text-sm sm:text-base text-gray-600">Total générés</div>
                        </div>
                    </div>
                </div>

                {# Stat 3 - nombre de pdf stockés #}
                {% if app.user.plan.name == 'FREE' %}
                    {# Free bloqué #}
                    <div class="bg-gray-50 border-2 border-gray-300 p-5 sm:p-6 rounded-xl shadow-sm opacity-75">
                        <div class="flex flex-col items-center justify-center h-full text-center">
                            <div class="w-12 h-12 sm:w-14 sm:h-14 bg-gray-200 rounded-lg flex items-center justify-center mb-3">
                                <i data-lucide="lock" class="w-6 h-6 sm:w-7 sm:h-7 text-gray-500"></i>
                            </div>
                            <div class="text-sm sm:text-base font-medium text-gray-700 mb-2">Stockage non disponible</div>
                            <a href="{{ path('app_subscription_change') }}" class="text-xs sm:text-sm text-blue-600 hover:underline font-medium">
                                Débloquer avec BASIC
                            </a>
                        </div>
                    </div>
                {% else %}
                    {# Pour basic et premium #}
                    <a href="{{ path('app_history') }}" class="bg-white border-2 border-green-200 p-5 sm:p-6 rounded-xl shadow-sm hover:shadow-md transition block group">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-10 h-10 sm:w-12 sm:h-12 bg-green-100 rounded-lg flex items-center justify-center">
                                <i data-lucide="hard-drive" class="w-5 h-5 sm:w-6 sm:h-6 text-green-700"></i>
                            </div>
                            <div>
                                <div class="text-2xl sm:text-3xl font-bold {{ stored_pdfs >= (app.user.plan.limitStorage ?? 999) ? 'text-red-600' : 'text-green-700' }}">
                                    {{ stored_pdfs }}{% if app.user.plan.limitStorage %}/{{ app.user.plan.limitStorage }}{% endif %}
                                </div>
                                <div class="text-sm sm:text-base text-gray-600 flex items-center gap-2">
                                    <span>PDFs stockés</span>
                                    <i data-lucide="arrow-right" class="w-4 h-4 opacity-0 group-hover:opacity-100 transition"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                {% endif %}
            </div>

            {# Nos outils #}
            <div class="bg-white rounded-2xl shadow-sm p-5 sm:p-8">
                <div class="flex items-center gap-3 mb-6 sm:mb-8">
                    <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-lg flex items-center justify-center">
                        <i data-lucide="wrench" class="w-4 h-4 sm:w-5 sm:h-5 text-white"></i>
                    </div>
                    <h2 class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900">Nos outils</h2>
                </div>

                {{ include('_partials/_tools_grid.html.twig', {tools: tools}) }}
            </div>
        </div>
    </div>
{% endblock %}