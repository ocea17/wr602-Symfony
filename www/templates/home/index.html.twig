{% extends 'base.html.twig' %}

{% block title %}Dashboard - PDF Generator{% endblock %}

{% block body %}
    {# Header #}
    {{ include('_partials/header.html.twig') }}

    {# Main content #}
    <div class="min-h-screen bg-gray-50 py-10">
        <div class="max-w-7xl mx-auto px-6">
            {# Welcome section #}
            <div class="mb-10">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">Bonjour {{ app.user.firstname }} !</h1>
                <span class="inline-block px-3 py-1 bg-blue-100 text-blue-600 rounded-md text-sm font-semibold">
                    {{ app.user.plan.name }}
                </span>
            </div>

            {# Stats grid #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                {# Stat 1 - PDFs aujourd'hui #}
                <div class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold {{ today_pdfs >= (app.user.plan.limitGeneration ?? 999) ? 'text-red-500' : 'text-blue-500' }} mb-2">
                        {{ today_pdfs }}/{{ app.user.plan.limitGeneration ?? '∞' }}
                    </div>
                    <div class="text-sm text-gray-600">PDFs aujourd'hui</div>
                </div>

                {# Stat 2 - Total généré #}
                <div class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-blue-500 mb-2">
                        {{ total_pdfs }}
                    </div>
                    <div class="text-sm text-gray-600">Total générés</div>
                </div>

                {# Stat 3 - Durée de stockage #}
                <div class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-blue-500 mb-2">
                        {% if app.user.plan.name == 'FREE' %}
                            7j
                        {% elseif app.user.plan.name == 'BASIC' %}
                            30j
                        {% else %}
                            ∞
                        {% endif %}
                    </div>
                    <div class="text-sm text-gray-600">Durée de stockage</div>
                </div>
            </div>

            {# Section Nos outils #}
            <div class="mb-10">
                <h2 class="text-3xl font-bold text-gray-900 mb-8">Nos outils</h2>

                {# Messages flash #}
                {% for message in app.flashes('success') %}
                    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                        {{ message }}
                    </div>
                {% endfor %}

                {% for message in app.flashes('error') %}
                    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                        {{ message }}
                    </div>
                {% endfor %}

                {# Grid des 3 modes #}
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {# Mode 1 : URL vers PDF #}
                    <a href="{{ path('app_pdf_generate_url') }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                        <div class="flex justify-center mb-4">
                            <i data-lucide="globe" class="w-12 h-12 text-blue-500"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">URL vers PDF</h3>
                        <p class="text-gray-600 text-sm">Convertir une page web en PDF</p>
                    </a>

                    {# Mode 2 : Fichier vers PDF #}
                    <a href="{{ path('app_pdf_generate_file') }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                        <div class="flex justify-center mb-4">
                            <i data-lucide="file-text" class="w-12 h-12 text-green-500"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">Fichier vers PDF</h3>
                        <p class="text-gray-600 text-sm">Upload un fichier HTML</p>
                    </a>

                    {# Mode 3 : Éditeur HTML #}
                    <a href="{{ path('app_pdf_generate_wysiwyg') }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                        <div class="flex justify-center mb-4">
                            <i data-lucide="pencil" class="w-12 h-12 text-purple-500"></i>
                        </div>
                        <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">Éditeur HTML</h3>
                        <p class="text-gray-600 text-sm">Écrire du HTML directement</p>
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}