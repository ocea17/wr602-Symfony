{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
    <div style="max-width: 800px; margin: 50px auto; padding: 20px;">
        <h1>Bienvenue sur votre espace PDF</h1>

        {% if app.user %}
            <p>Bonjour <strong>{{ app.user.firstname }} {{ app.user.lastname }}</strong> !</p>

            <p>
                Votre abonnement actuel :
                <strong style="color: #007bff;">{{ app.user.plan.name }}</strong>
            </p>

            <div style="margin-top: 30px;">
                <a href="{{ path('app_subscription_change') }}" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">
                    Gérer mon abonnement
                </a>
            </div>
            <div style="margin-top: 15px;">
                <a href="{{ path('app_history') }}" style="display: inline-block; padding: 10px 20px; background-color: #28a745; color: white; text-decoration: none; border-radius: 3px;">
                    📋 Voir mon historique
                </a>
            </div>

            <div style="margin-top: 15px;">
                <a href="{{ path('app_logout') }}" style="color: #dc3545;">Se déconnecter</a>
            </div>
        {% else %}
            <p>Vous n'êtes pas connecté.</p>
            <a href="{{ path('app_login') }}">Se connecter</a>
        {% endif %}
    </div>
{% endblock %}