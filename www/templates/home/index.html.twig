{% extends 'base.html.twig' %}

{% block title %}Dashboard - PDF Generator{% endblock %}

{% block body %}

    {# Main content #}
    <div class="min-h-screen bg-gray-50 py-10">
        <div class="max-w-7xl mx-auto px-6">
            {# Welcome section #}
            <div class="mb-10">
                <h1 class="text-4xl font-bold text-gray-900 mb-3">Bonjour {{ app.user.firstname }} !</h1>
                {# Badge #}
                <span class="inline-block px-3 py-1 rounded-md text-sm font-semibold mb-4
                        {% if app.user.plan.name == 'FREE' %}bg-gray-100 text-gray-700
                        {% elseif app.user.plan.name == 'BASIC' %}bg-blue-100 text-blue-600
                        {% else %}bg-purple-100 text-purple-600{% endif %}">
                        {{ app.user.plan.name }}
                    </span>
            </div>

            {# Stats grid #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                {# Stat 1 - PDFs aujourd'hui #}
                <div class="bg-blue-100 p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold {{ today_pdfs >= (app.user.plan.limitGeneration ?? 999) ? 'text-red-500' : 'text-blue-500' }} mb-2">
                        {{ today_pdfs }}/{{ app.user.plan.limitGeneration }}
                    </div>
                    <div class="text-lg text-gray-800 mb-2">PDFs aujourd'hui</div>

                    {# Si proche de la limite #}
                    {% if today_pdfs >= (app.user.plan.limitGeneration ?? 999) %}
                        <a href="{{ path('app_subscription_change') }}" class="text-xs text-blue-600 hover:underline font-medium">
                            Limite atteinte - Améliorer mon plan
                        </a>
                    {% endif %}
                </div>

                {# Stat 2 - Total généré #}
                <div class="bg-purple-100 p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-purple-500 mb-2">
                        {{ total_pdfs }}
                    </div>
                    <div class="text-lg text-gray-800">Total générés</div>
                </div>

                {# Stat 3 - PDFs stockés #}
                {% if app.user.plan.name == 'FREE' %}
                    {# FREE #}
                    <div class="bg-gray-100 p-6 rounded-xl shadow-sm border-2 border-gray-300 opacity-60">
                        <div class="flex justify-center mb-2">
                            <i data-lucide="lock" class="w-10 h-10 text-gray-400"></i>
                        </div>
                        <div class="text-lg text-gray-800 text-center">Stockage non disponible</div>
                        <div class="text-center mt-2">
                            <a href="{{ path('app_subscription_change') }}" class="text-blue-500 hover:text-blue-600 text-xs font-medium hover:underline">
                                Améliorer mon plan
                            </a>
                        </div>
                    </div>
                {% else %}
                    {# BASIC / PREMIUM #}
                    <a href="{{ path('app_history') }}" class="bg-green-200 p-6 rounded-xl shadow-sm hover:shadow-md transition block group">
                        <div class="text-4xl font-bold mb-2 {{ stored_pdfs >= (app.user.plan.limitStorage ?? 999) ? 'text-red-500' : 'text-green-700' }}">
                            {{ stored_pdfs }}{% if app.user.plan.limitStorage %}/{{ app.user.plan.limitStorage }}{% endif %}
                        </div>
                        <div class="text-lg text-gray-800 flex items-center justify-between">
                            <span>PDFs stockés</span>
                            <i data-lucide="arrow-right" class="w-4 h-4 opacity-100 transition"></i>
                        </div>
                    </a>
                {% endif %}
            </div>
        </div>

        {# Nos outils #}
        <div class="max-w-7xl mx-auto px-6 mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-8">Nos outils</h2>

            {{ include('_partials/_tools_grid.html.twig', {tools: tools}) }}
        </div>
    </div>
{% endblock %}