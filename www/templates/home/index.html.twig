{% extends 'base.html.twig' %}

{% block title %}Dashboard - PDF Generator{% endblock %}

{% block body %}
    {# Header #}
    {{ include('_partials/header.html.twig') }}

    {# Main content #}
    <div class="min-h-screen bg-gray-50 py-10">
        <div class="max-w-7xl mx-auto px-6">
            {# Welcome section #}
            <div class="mb-10">
                <h1 class="text-4xl font-bold text-gray-900 mb-2">Bonjour {{ app.user.firstname }} !</h1>
                <span class="inline-block px-3 py-1 bg-blue-100 text-blue-600 rounded-md text-sm font-semibold">
                    {{ app.user.plan.name }}
                </span>
            </div>

            {# Stats grid #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                {# Stat 1 - PDFs aujourd'hui #}
                <div class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold {{ today_pdfs >= (app.user.plan.limitGeneration ?? 999) ? 'text-red-500' : 'text-blue-500' }} mb-2">
                        {{ today_pdfs }}/{{ app.user.plan.limitGeneration ?? '∞' }}
                    </div>
                    <div class="text-sm text-gray-600">PDFs aujourd'hui</div>
                </div>

                {# Stat 2 - Total généré #}
                <div class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-blue-500 mb-2">
                        {{ total_pdfs }}
                    </div>
                    <div class="text-sm text-gray-600">Total générés</div>
                </div>

                {# Stat 3 - Durée de stockage #}
                <div class="bg-white p-6 rounded-xl shadow-sm">
                    <div class="text-4xl font-bold text-blue-500 mb-2">
                        {% if app.user.plan.name == 'FREE' %}
                            7j
                        {% elseif app.user.plan.name == 'BASIC' %}
                            30j
                        {% else %}
                            ∞
                        {% endif %}
                    </div>
                    <div class="text-sm text-gray-600">Durée de stockage</div>
                </div>
            </div>
        </div> {# Fin du conteneur stats #}

        {# Section Nos outils - Alignement cohérent #}
        <div class="max-w-7xl mx-auto px-6 mb-10">
            <h2 class="text-3xl font-bold text-gray-900 mb-8">Nos outils</h2>

            {# Grid des tools centré dans son conteneur #}
            <div class="max-w-5xl mx-auto">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-fr">
                    {% for tool in tools %}
                        {% if is_granted('TOOL_ACCESS', tool) %}
                            <a href="{{ path('app_convert_tool', {slug: tool.slug}) }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                                <div class="flex justify-center mb-4">
                                    {% if tool.slug == 'url' %}
                                        <i data-lucide="globe" class="w-12 h-12 text-blue-500"></i>
                                    {% elseif tool.slug == 'html' %}
                                        <i data-lucide="file-text" class="w-12 h-12 text-green-500"></i>
                                    {% elseif tool.slug == 'wysiwyg' %}
                                        <i data-lucide="pencil" class="w-12 h-12 text-purple-500"></i>
                                    {% elseif tool.slug == 'merge' %}
                                        <i data-lucide="git-merge" class="w-12 h-12 text-orange-500"></i>
                                    {% elseif tool.slug == 'split' %}
                                        <i data-lucide="scissors" class="w-12 h-12 text-red-500"></i>
                                    {% endif %}
                                </div>
                                <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">{{ tool.name }}</h3>
                                <p class="text-gray-500 text-sm mb-12">{{ tool.description }}</p>
                            </a>
                        {% else %}
                            <div class="bg-gray-100 rounded-xl p-8 shadow-sm border-2 border-gray-300 text-center opacity-60">
                                <div class="flex justify-center mb-4">
                                    <i data-lucide="lock" class="w-12 h-12 text-gray-400"></i>
                                </div>
                                <h3 class="text-xl font-semibold text-gray-500 mb-2">{{ tool.name }}</h3>
                                <p class="text-gray-500 text-sm mb-4">{{ tool.description }}</p>
                                <a href="{{ path('app_subscription_change') }}" class="inline-block px-4 py-2 bg-blue-500 text-white rounded-lg text-sm hover:bg-blue-600 transition">
                                    Améliorer mon plan
                                </a>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}