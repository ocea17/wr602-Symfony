{% extends 'base.html.twig' %}

{% block title %}Paiement annulé - PDF Generator{% endblock %}

{% block body %}

    <div class="bg-gray-50 py-20">
        <div class="max-w-2xl mx-auto px-6 text-center">
            <div class="bg-white rounded-xl shadow-lg p-12">
                <div class="flex justify-center mb-6">
                    <div class="w-20 h-20 bg-orange-100 rounded-full flex items-center justify-center">
                        <i data-lucide="x" class="w-12 h-12 text-orange-500"></i>
                    </div>
                </div>
                
                <h1 class="text-3xl font-bold text-gray-900 mb-4">Paiement annulé</h1>
                
                <p class="text-gray-600 mb-8">
                    Vous avez annulé le paiement. Aucun montant n'a été débité.
                </p>
                
                <div class="flex gap-4 justify-center">
                    <a href="{{ path('app_subscription_change') }}" class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
                        Voir les plans
                    </a>
                    <a href="{{ path('app_home') }}" class="inline-block px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg transition">
                        Retour au dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
