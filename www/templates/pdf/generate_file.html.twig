{% extends 'base.html.twig' %}

{% block title %}Générer PDF depuis fichier{% endblock %}

{% block body %}
    <div style="max-width: 600px; margin: 50px auto; padding: 20px;">
        <h1>Générer un PDF depuis un fichier</h1>

        {% for message in app.flashes('error') %}
            <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 3px; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" enctype="multipart/form-data" data-turbo="false">
            <div style="margin-bottom: 15px;">
                <label for="file">Fichier HTML :</label>
                <input type="file" id="file" name="file" accept=".html,.htm" required style="width: 100%; padding: 8px;">
                <small style="color: #666;">Formats acceptés : .html, .htm</small>
            </div>

            <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                Générer le PDF
            </button>
        </form>

        <div style="margin-top: 20px;">
            <a href="{{ path('app_pdf_index') }}">← Retour</a>
        </div>
    </div>
{% endblock %}