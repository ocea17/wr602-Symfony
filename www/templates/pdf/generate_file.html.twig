{% extends 'base.html.twig' %}

{% block title %}Fichier vers PDF - PDF Generator{% endblock %}

{% block body %}
    {# Header#}
    {{ include('_partials/header.html.twig') }}

    <div class="py-10">
        <div class="max-w-2xl mx-auto px-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Fichier vers PDF</h1>
            <p class="text-gray-600 mb-8">Téléverser un fichier HTML pour le convertir</p>

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="bg-white rounded-xl shadow-sm p-8">
                <form method="post" enctype="multipart/form-data" data-turbo="false">
                    <div class="mb-6">
                        <label class="block text-sm font-medium text-gray-700 mb-4">Fichier HTML</label>
                        <div class="border-2 border-dashed border-gray-300 rounded-lg p-12 text-center hover:border-blue-500 hover:bg-blue-50 transition cursor-pointer">
                            <div class="text-5xl mb-3">
                                <div class="text-center mb-4">
                                    <i data-lucide="folder" style="width:45px; height:45px;" class="mx-auto w-16 h-16 text-blue-500"></i>
                                </div>
                            </div>
                            <input
                                    type="file"
                                    name="file"
                                    id="file"
                                    accept=".html,.htm"
                                    class="hidden"
                                    required
                                    onchange="document.getElementById('filename').textContent = this.files[0]?.name || 'Aucun fichier sélectionné'"
                            >
                            <label for="file" class="cursor-pointer">
                                <span class="text-gray-600">Cliquez pour parcourir ou glissez un fichier ici</span>
                                <div class="text-sm text-gray-500 mt-2">Formats acceptés : .html, .htm (max 10 MB)</div>
                                <div id="filename" class="text-sm text-blue-500 font-medium mt-2"></div>
                            </label>
                        </div>
                    </div>

                    <button
                            type="submit"
                            class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg transition transform hover:scale-105"
                    >
                        Générer le PDF
                    </button>
                </form>
            </div>

            {{ include('_partials/pdf_benefits.html.twig') }}

            <div class="text-center mt-6">
                <a href="{{ path('app_pdf_index') }}" class="text-blue-500 hover:text-blue-600 font-medium hover:underline">
                    ← Choisir un autre mode
                </a>
            </div>
        </div>
    </div>
{% endblock %}