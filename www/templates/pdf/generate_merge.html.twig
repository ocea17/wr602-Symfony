{% extends 'base.html.twig' %}

{% block title %}Fusionner des PDFs - PDF Generator{% endblock %}

{% block body %}

    <div class="py-10">
        <div class="max-w-2xl mx-auto px-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-8">Fusionner des PDFs</h1>

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="bg-white rounded-xl shadow-sm p-8">
                <form method="post" enctype="multipart/form-data" data-turbo="false">

                    {{ include('_partials/_file_upload.html.twig', {
                        name: 'files[]',
                        accept: '.pdf',
                        label: 'Sélectionnez plusieurs PDFs',
                        formats: '.pdf (minimum 2 fichiers)',
                        multiple: true,
                        required: true
                    }) }}

                    <button type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
                        Fusionner les PDFs
                    </button>
                </form>
            </div>

            {{ include('_partials/pdf_benefits.html.twig') }}

            <div class="text-center mt-8">
                <a href="{{ path('app_pdf_index') }}" class="text-blue-600 hover:text-blue-700 font-medium hover:underline">
                    ← Retour aux outils
                </a>
            </div>
        </div>
    </div>
{% endblock %}
