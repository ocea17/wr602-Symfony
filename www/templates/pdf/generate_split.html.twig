{% extends 'base.html.twig' %}

{% block title %}Séparer un PDF - PDF Generator{% endblock %}

{% block body %}

    <div class="py-10">
        <div class="max-w-2xl mx-auto px-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-8">Séparer un PDF</h1>

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="bg-white rounded-xl shadow-sm p-8">
                <form method="post" enctype="multipart/form-data" data-turbo="false">
                    <div class="mb-6">
                        {{ include('_partials/_file_upload.html.twig', {
                            name: 'files[]',
                            accept: '.pdf',
                            label: 'Sélectionnez plusieurs PDFs',
                            formats: '.pdf',
                            multiple: true,
                            required: true
                        }) }}
                    </div>

                    <div class="grid grid-cols-2 gap-4 mb-6">
                        <div>
                            <label for="start_page" class="block text-sm font-medium text-gray-700 mb-2">
                                Page de début
                            </label>
                            <input 
                                type="number" 
                                id="start_page" 
                                name="start_page" 
                                value="1"
                                min="1"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            >
                        </div>

                        <div>
                            <label for="end_page" class="block text-sm font-medium text-gray-700 mb-2">
                                Page de fin
                            </label>
                            <input 
                                type="number" 
                                id="end_page" 
                                name="end_page" 
                                value="1"
                                min="1"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                            >
                        </div>
                    </div>

                    <button type="submit" class="w-full px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition">
                        Extraire les pages
                    </button>
                </form>
            </div>

            {{ include('_partials/pdf_benefits.html.twig') }}

            <div class="text-center mt-8">
                <a href="{{ path('app_pdf_index') }}" class="text-blue-600 hover:text-blue-700 font-medium hover:underline">
                    ← Retour aux outils
                </a>
            </div>
        </div>
    </div>
{% endblock %}
