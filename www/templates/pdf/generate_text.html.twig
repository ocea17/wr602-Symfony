{% extends 'base.html.twig' %}

{% block title %}Fichier texte vers PDF - PDF Generator{% endblock %}

{% block body %}
    {{ include('_partials/header.html.twig') }}

    <div class="py-12 px-6">
        <div class="max-w-3xl mx-auto">
            <div class="bg-white rounded-xl shadow-lg p-8">
                <div class="flex items-center gap-3 mb-6">
                    <i data-lucide="file-type" class="w-8 h-8 text-gray-500"></i>
                    <h1 class="text-3xl font-bold text-gray-900">Fichier texte vers PDF</h1>
                </div>

                <p class="text-gray-600 mb-8">
                    Convertissez vos fichiers texte (.txt) en PDF.
                </p>

                <form method="post" enctype="multipart/form-data" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Sélectionnez un fichier texte
                        </label>
                        <input
                                type="file"
                                name="file"
                                accept=".txt"
                                required
                                class="block w-full text-sm text-gray-900 border border-gray-300 rounded-lg cursor-pointer bg-gray-50 focus:outline-none focus:ring-2 focus:ring-gray-500 p-2.5"
                        >
                        <p class="mt-2 text-sm text-gray-500">
                            Format accepté : TXT
                        </p>
                    </div>

                    <button
                            type="submit"
                            class="w-full py-3 px-6 bg-gray-500 hover:bg-gray-600 text-white font-semibold rounded-lg transition transform hover:scale-105"
                    >
                        Convertir en PDF
                    </button>
                </form>
            </div>

            <div class="mt-8 text-center">
                <a href="{{ path('app_pdf_index') }}" class="text-gray-500 hover:text-gray-600 font-medium">
                    ← Retour aux outils
                </a>
            </div>
        </div>
    </div>
{% endblock %}