{% extends 'base.html.twig' %}

{% block title %}Génération de PDF{% endblock %}

{% block body %}
    <div style="max-width: 800px; margin: 50px auto; padding: 20px;">
        <h1>Générer un PDF</h1>

        <p>Choisissez le mode de génération :</p>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-top: 30px;">
            <div style="border: 1px solid #ddd; padding: 20px; text-align: center; border-radius: 5px;">
                <h3>URL vers PDF</h3>
                <p>Convertir une page web en PDF</p>
                <a href="{{ path('app_pdf_generate_url') }}" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">
                    Commencer
                </a>
            </div>

            <div style="border: 1px solid #ddd; padding: 20px; text-align: center; border-radius: 5px;">
                <h3>Fichier vers PDF</h3>
                <p>Upload un fichier HTML</p>
                <a href="{{ path('app_pdf_generate_file') }}" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">
                    Commencer
                </a>
            </div>

            <div style="border: 1px solid #ddd; padding: 20px; text-align: center; border-radius: 5px;">
                <h3>Éditeur HTML</h3>
                <p>Écrire du HTML directement</p>
                <a href="{{ path('app_pdf_generate_wysiwyg') }}" style="display: inline-block; padding: 10px 20px; background-color: #007bff; color: white; text-decoration: none; border-radius: 3px;">
                    Commencer
                </a>
            </div>
        </div>

        <div style="margin-top: 30px;">
            <a href="{{ path('app_home') }}">← Retour à l'accueil</a>
        </div>
    </div>
{% endblock %}