{% extends 'base.html.twig' %}

{% block title %}Générer un PDF - PDF Generator{% endblock %}

{% block body %}
    {# Header#}
    {{ include('_partials/header.html.twig') }}

    {# Main content #}
    <div class="min-h-screen bg-gray-50 py-10">
        <div class="max-w-4xl mx-auto px-6">
            <h1 class="text-4xl font-bold text-gray-900 mb-8">Générer un PDF</h1>

            {# Messages flash #}
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {# Grid des 3 modes #}
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
                {# Mode 1 : URL vers PDF #}
                <a href="{{ path('app_pdf_generate_url') }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                    <div class="text-center mb-4">
                        <i data-lucide="globe" style="width:45px; height:45px;" class="mx-auto w-16 h-16 text-blue-500"></i>
                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">URL vers PDF</h3>
                    <p class="text-gray-600 text-sm">Convertir une page web en PDF</p>
                </a>

                {# Mode 2 : Fichier vers PDF #}
                <a href="{{ path('app_pdf_generate_file') }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                    <div class="text-center mb-4">
                        <i data-lucide="file" style="width:45px; height:45px;" class="mx-auto text-green-500"></i>

                    </div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">Fichier vers PDF</h3>
                    <p class="text-gray-600 text-sm">Upload un fichier HTML</p>
                </a>

                {# Mode 3 : Éditeur HTML #}
                <a href="{{ path('app_pdf_generate_wysiwyg') }}" class="bg-white rounded-xl p-8 shadow-sm border-2 border-gray-200 hover:border-blue-500 hover:shadow-lg transition transform hover:-translate-y-1 text-center group">
                    <div class="text-center mb-4">
                        <i data-lucide="pencil" style="width:45px; height:45px;" class="mx-auto w-16 h-16 text-purple-500"></i>
                    </div>

                    <h3 class="text-xl font-semibold text-gray-900 mb-2 group-hover:text-blue-500">Éditeur HTML</h3>
                    <p class="text-gray-600 text-sm">Écrire du HTML directement</p>
                </a>
            </div>

            {# Retour #}
            <div class="text-center">
                <a href="{{ path('app_home') }}" class="text-blue-500 hover:text-blue-600 font-medium hover:underline">
                    ← Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}