{% extends 'base.html.twig' %}

{% block title %}Générer PDF depuis éditeur{% endblock %}

{% block body %}
    <div style="max-width: 800px; margin: 50px auto; padding: 20px;">
        <h1>Générer un PDF depuis l'éditeur HTML</h1>

        {% for message in app.flashes('error') %}
            <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 3px; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" data-turbo="false">
            <div style="margin-bottom: 15px;">
                <label for="html_content">Contenu HTML :</label>
                <textarea id="html_content" name="html_content" rows="15" required style="width: 100%; padding: 8px; font-family: monospace;"><!DOCTYPE html>
<html>
<head>
    <title>Mon PDF</title>
</head>
<body>
    <h1>Titre de mon document</h1>
    <p>Contenu du document...</p>
</body>
</html></textarea>
                <small style="color: #666;">Écrivez votre HTML directement ici</small>
            </div>

            <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                Générer le PDF
            </button>
        </form>

        <div style="margin-top: 20px;">
            <a href="{{ path('app_pdf_index') }}">← Retour</a>
        </div>
    </div>
{% endblock %}