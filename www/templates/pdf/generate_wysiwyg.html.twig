{% extends 'base.html.twig' %}

{% block title %}Créer un document - PDF Generator{% endblock %}

{% block body %}
    {# Header #}
    {{ include('_partials/header.html.twig') }}

    <div class="py-10">
        <div class="max-w-3xl mx-auto px-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">Créer un document</h1>
            <p class="text-gray-600 mb-8">Remplissez les champs pour générer votre PDF</p>

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="bg-white rounded-xl shadow-sm p-8">
                <form method="post" data-turbo="false">
                    <div class="mb-6">
                        <label for="title" class="block text-sm font-medium text-gray-700 mb-2">Titre du document</label>
                        <input
                                type="text"
                                id="title"
                                name="title"
                                placeholder="Mon document"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                required
                        >
                    </div>

                    <div class="mb-6">
                        <label for="content" class="block text-sm font-medium text-gray-700 mb-2">Contenu</label>
                        <textarea
                                id="content"
                                name="content"
                                rows="15"
                                placeholder="Écrivez votre contenu ici..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                required
                        ></textarea>
                        <p class="text-sm text-gray-500 mt-2">Le texte sera formaté automatiquement dans le PDF.</p>
                    </div>

                    <button
                            type="submit"
                            class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg transition transform hover:scale-105"
                    >
                        Générer le PDF
                    </button>
                </form>
            </div>

            {{ include('_partials/pdf_benefits.html.twig') }}

            <div class="text-center mt-6">
                <a href="{{ path('app_pdf_index') }}" class="text-blue-500 hover:text-blue-600 font-medium hover:underline">
                    ← Choisir un autre mode
                </a>
            </div>
        </div>
    </div>
{% endblock %}