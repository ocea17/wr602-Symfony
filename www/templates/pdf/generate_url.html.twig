{% extends 'base.html.twig' %}

{% block title %}URL vers PDF - PDF Generator{% endblock %}

{% block body %}
    {# Header #}
    {{ include('_partials/header.html.twig') }}

    <div class="min-h-screen bg-gray-50 py-10">
        <div class="max-w-2xl mx-auto px-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-2">URL vers PDF</h1>
            <p class="text-gray-600 mb-8">Convertissez n'importe quelle page web en PDF</p>

            {# Messages flash #}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            <div class="bg-white rounded-xl shadow-sm p-8">
                <form method="post" data-turbo="false">
                    <div class="mb-6">
                        <label for="url" class="block text-sm font-medium text-gray-700 mb-2">URL de la page</label>
                        <input
                                type="url"
                                id="url"
                                name="url"
                                placeholder="https://example.com"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                                required
                        >
                        <p class="text-sm text-gray-500 mt-2">Entrez l'URL complète de la page à convertir</p>
                    </div>

                    <button
                            type="submit"
                            class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 px-6 rounded-lg transition transform hover:scale-105"
                    >
                        Générer le PDF
                    </button>
                </form>
            </div>

            {{ include('_partials/pdf_benefits.html.twig') }}

            <div class="text-center mt-6">
                <a href="{{ path('app_pdf_index') }}" class="text-blue-500 hover:text-blue-600 font-medium hover:underline">
                    ← Choisir un autre mode
                </a>
            </div>
        </div>
    </div>
{% endblock %}