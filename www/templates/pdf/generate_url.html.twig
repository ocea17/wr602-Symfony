{% extends 'base.html.twig' %}

{% block title %}Générer PDF depuis URL{% endblock %}

{% block body %}
    <div style="max-width: 600px; margin: 50px auto; padding: 20px;">
        <h1>Générer un PDF depuis une URL</h1>

        {% for message in app.flashes('error') %}
            <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 3px; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 3px; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" data-turbo="false">
            <div style="margin-bottom: 15px;">
                <label for="url">URL de la page :</label>
                <input type="url" id="url" name="url" required placeholder="https://example.com" style="width: 100%; padding: 8px;">
            </div>

            <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                Générer le PDF
            </button>
        </form>

        <div style="margin-top: 20px;">
            <a href="{{ path('app_pdf_index') }}">← Retour</a>
        </div>
    </div>
{% endblock %}