{% extends 'base.html.twig' %}

{% block title %}Modifier un contact - PDF Generator{% endblock %}

{% block body %}

    <div class="py-10">
        <div class="max-w-2xl mx-auto px-6">
            <h1 class="text-3xl font-bold text-gray-900 mb-8">Modifier le contact</h1>

            <div class="bg-white rounded-xl shadow-sm p-8">
                {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                <div class="mb-6">
                    {{ form_label(form.lastname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.lastname) }}
                    {{ form_errors(form.lastname) }}
                </div>

                <div class="mb-6">
                    {{ form_label(form.firstname, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.firstname) }}
                    {{ form_errors(form.firstname) }}
                </div>

                <div class="mb-6">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-2'}}) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                <div class="flex gap-4">
                    <button type="submit" class="flex-1 px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition flex justify-center">
                        <span class="flex items-center gap-2"><i data-lucide="save" class="w-5 h-5"></i>Enregistrer</span>
                    </button>
                    <a href="{{ path('app_contacts_index') }}" class="flex-1 px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg transition text-center">
                        Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>

            <div class="text-center mt-8">
                <a href="{{ path('app_contacts_index') }}" class="text-blue-600 hover:text-blue-700 font-medium hover:underline">
                    ← Retour à mes contacts
                </a>
            </div>
        </div>
    </div>
{% endblock %}