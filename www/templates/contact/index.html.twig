{% extends 'base.html.twig' %}

{% block title %}Mes contacts - PDF Generator{% endblock %}

{% block body %}
    {{ include('_partials/header.html.twig') }}

    {% set hasAccess = is_granted('CONTACT_VIEW') %}

    <div class="relative min-h-[calc(100vh-169px)]">
        {# Overlay modal pour FREE #}
        {% if not hasAccess %}
            <div class="absolute inset-0 bg-gray-900 bg-opacity-70 backdrop-blur-[2px] z-50 flex items-center justify-center px-4">
                <div class="bg-white rounded-xl shadow-2xl p-8 max-w-md mx-auto text-center">
                    <div class="mb-4">
                        <i data-lucide="lock" class="w-16 h-16 text-blue-500 mx-auto"></i>
                    </div>
                    <h2 class="text-2xl font-bold text-gray-900 mb-4"> Fonctionnalité BASIC</h2>
                    <p class="text-gray-600 mb-6">
                        Gérez vos contacts avec un abonnement <strong>BASIC</strong> ou <strong>PREMIUM</strong>
                    </p>
                    <a href="{{ path('app_subscription_change') }}" class="inline-block py-3 px-8 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg transition transform hover:scale-105">
                        Améliorer mon plan
                    </a>
                </div>
            </div>
        {% endif %}

        {# Contenu (flouté) #}
        <div class="py-10 max-w-7xl mx-auto px-6 {% if not hasAccess %}filter blur-[1px] pointer-events-none select-none{% endif %}">
            <div class="flex justify-between items-center mb-8">
                <h1 class="text-3xl font-bold text-gray-900">Mes contacts</h1>
                <a href="{{ path('app_contacts_new') }}" class="px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg transition flex justify-center">
                    <span class="flex items-center gap-2"><i data-lucide="plus" class="w-6 h-6"></i>Ajouter un contact</span>
                </a>
            </div>

            {# Messages flash #}
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% if contacts is empty %}
                <div class="bg-white rounded-xl shadow-sm p-12 text-center">
                    <div class="text-6xl mb-4 flex justify-center"><i data-lucide="user" class="w-12 h-12 text-black-500"></i></div>
                    <h3 class="text-xl font-semibold text-gray-900 mb-2">Aucun contact</h3>
                    <p class="text-gray-600 mb-6">Commencez par ajouter votre premier contact !</p>
                    <a href="{{ path('app_contacts_new') }}" class="inline-block px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg transition">
                        <span class="flex items-center gap-2"><i data-lucide="plus" class="w-6 h-6"></i>Ajouter un contact</span>
                    </a>
                </div>
            {% else %}
                <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                    <table class="w-full text-sm text-left">
                        <thead class="bg-gray-50 border-b">
                        <tr>
                            <th class="px-6 py-4 font-semibold text-gray-900">Nom</th>
                            <th class="px-6 py-4 font-semibold text-gray-900">Prénom</th>
                            <th class="px-6 py-4 font-semibold text-gray-900">Email</th>
                            <th class="px-6 py-4 font-semibold text-gray-900">Actions</th>
                        </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-200">

                        {% for contact in contacts %}
                            <tr class="hover:bg-gray-50 transition-colors">

                                <td class="px-6 py-4 font-medium text-gray-900">
                                    {{ contact.lastname }}
                                </td>

                                <td class="px-6 py-4 text-gray-700">
                                    {{ contact.firstname }}
                                </td>

                                <td class="px-6 py-4 text-gray-600">
                                    {{ contact.email }}
                                </td>

                                <td class="px-6 py-4">
                                    <div class="flex items-center gap-3">

                                        <a href="{{ path('app_contacts_edit', {id: contact.id}) }}" class="inline-flex items-center gap-2 px-3 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg transition">

                                            <i data-lucide="pencil" class="w-4 h-4"></i>
                                            Modifier

                                        </a>

                                        <form method="post" action="{{ path('app_contacts_delete', {id: contact.id}) }}" onsubmit="return confirm('Supprimer ce contact ?');">

                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ contact.id) }}">

                                            <button type="submit"
                                                    class="inline-flex items-center gap-2 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition">

                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                Supprimer

                                            </button>
                                        </form>

                                    </div>
                                </td>

                            </tr>
                        {% endfor %}

                        </tbody>
                    </table>
                </div>
            {% endif %}

            <div class="text-center mt-8">
                <a href="{{ path('app_home') }}" class="text-blue-500 hover:text-blue-600 font-medium hover:underline">
                    ← Retour au dashboard
                </a>
            </div>
        </div>
    </div>
{% endblock %}