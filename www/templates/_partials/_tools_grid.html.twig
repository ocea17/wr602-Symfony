{# Grille des outils - Réutilisable #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% for tool in tools %}
        {% set is_accessible = is_granted('TOOL_ACCESS', tool) %}

        <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 {{ is_accessible ? 'hover:shadow-md' : '' }} transition min-h-[280px] flex flex-col {{ is_accessible ? 'justify-center' : 'justify-between' }}">
            {# Icône de l'outil #}
            <div class="flex justify-center mb-4">
                {% if tool.slug == 'url' %}
                    <i data-lucide="globe" class="w-12 h-12 text-blue-500"></i>
                {% elseif tool.slug == 'html' %}
                    <i data-lucide="file-text" class="w-12 h-12 text-green-500"></i>
                {% elseif tool.slug == 'wysiwyg' %}
                    <i data-lucide="pencil" class="w-12 h-12 text-orange-500"></i>
                {% elseif tool.slug == 'merge' %}
                    <i data-lucide="git-merge" class="w-12 h-12 text-yellow-500"></i>
                {% elseif tool.slug == 'split' %}
                    <i data-lucide="scissors" class="w-12 h-12 text-red-500"></i>
                {% elseif tool.slug == 'screenshot' %}
                    <i data-lucide="file-image" class="w-12 h-12 text-purple-500"></i>
                {% endif %}
            </div>

            {# Titre #}
            <h3 class="text-xl font-semibold text-gray-900 mb-2 text-center">{{ tool.name }}</h3>

            {# Description #}
            <p class="text-gray-600 text-sm text-center mb-4">{{ tool.description }}</p>

            {# Bouton #}
            {% if is_accessible %}
                    <a href="{{ path('app_convert_tool', {slug: tool.slug}) }}" class="block w-full px-6 py-3  bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white font-semibold rounded-lg text-center transition">
                        Générer
                    </a>
            {% else %}
                <div class="text-center">
                    <div class="inline-flex items-center gap-2 text-gray-400 mb-3">
                        <i data-lucide="lock" class="w-5 h-5"></i>
                        <span class="text-sm font-medium">Outil verrouillé</span>
                    </div>
                    <a href="{{ path('app_subscription_change') }}" class="block w-full px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-lg text-center transition">
                        Améliorer mon plan
                    </a>
                </div>
            {% endif %}
        </div>
    {% endfor %}
</div>