<header class="bg-white border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
            {# Logo #}
            <a href="{{ path('app_home') }}">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg">
                        <i data-lucide="file-text" class="w-6 h-6 text-white"></i>
                    </div>
                    <span class="text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">PDF Generator</span>
                </div>
            </a>

            {# Navigation #}
            <nav class="flex gap-8">
                <a href="{{ path('app_home') }}" class="{% if app.request.get('_route') == 'app_home' %}text-blue-500 font-medium border-b-2 border-blue-500 pb-1{% else %}text-gray-600 hover:text-blue-500 font-medium transition{% endif %}">
                    Accueil
                </a>
                <a href="{{ path('app_pdf_index') }}" class="{% if app.request.get('_route') starts with 'app_pdf' %}text-blue-500 font-medium border-b-2 border-blue-500 pb-1{% else %}text-gray-600 hover:text-blue-500 font-medium transition{% endif %}">
                    Générer PDF
                </a>
                <a href="{{ path('app_history') }}" class="{% if app.request.get('_route') == 'app_history' %}text-blue-500 font-medium border-b-2 border-blue-500 pb-1{% else %}text-gray-600 hover:text-blue-500 font-medium transition{% endif %}">
                    Historique
                </a>
                <a href="{{ path('app_subscription_change') }}" class="{% if app.request.get('_route') == 'app_subscription_change' %}text-blue-500 font-medium border-b-2 border-blue-500 pb-1{% else %}text-gray-600 hover:text-blue-500 font-medium transition{% endif %}">
                    Tarifs
                </a>
                <a href="{{ path('app_contacts_index') }}" class="{% if app.request.get('_route') == 'app_contacts_index' %}text-blue-500 font-medium border-b-2 border-blue-500 pb-1{% else %}text-gray-600 hover:text-blue-500 font-medium transition{% endif %}">
                    Contact
                </a>
            </nav>

            {# User menu #}
            {% if app.user %}
                <div class="flex items-center gap-3">
                    {# Profil #}
                    <a href="{{ path('app_profile') }}"
                       class="flex items-center gap-2 px-4 py-2 bg-gray-100 rounded-lg hover:bg-gray-200 transition">
                        <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-semibold text-sm"
                             style="background-color: {{ app.user.avatarColor }};">
                            {{ app.user.firstname|first|upper }}{{ app.user.lastname|first|upper }}
                        </div>
                        <span class="text-sm font-medium">{{ app.user.firstname }}</span>
                    </a>

                    {# Déconnexion #}
                    <a href="{{ path('app_logout') }}"
                       class="flex items-center gap-2 px-4 py-3 text-red-600 bg-red-100 hover:bg-red-200 rounded-lg transition"
                       title="Déconnexion">
                        <i data-lucide="log-out" class="w-5 h-5"></i>
                        <span class="text-sm font-medium hidden md:inline">Déconnexion</span>
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</header>