{# Cards de confiances#}
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10">
    {# Card 1 - rapidité #}
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 text-center">
        <div class="flex justify-center mb-4">
            <i data-lucide="zap" class="w-12 h-12 text-blue-500"></i>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Rapide</h3>
        <p class="text-sm text-gray-600">Conversion en quelques secondes</p>
    </div>

    {# Card 2 - sécurité #}
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 text-center">
        <div class="flex justify-center mb-4">
            <i data-lucide="shield-check" class="w-12 h-12 text-green-500"></i>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Sécurisé</h3>
        <p class="text-sm text-gray-600">Vos fichiers ne sont pas conservés</p>
    </div>

    {# Card 3 - rendu fidèle #}
    <div class="bg-white rounded-xl p-6 shadow-sm border border-gray-200 text-center">
        <div class="flex justify-center mb-4">
            <i data-lucide="check-circle" class="w-12 h-12 text-purple-500"></i>
        </div>
        <h3 class="text-lg font-semibold text-gray-900 mb-2">Rendu fidèle</h3>
        <p class="text-sm text-gray-600">Via un moteur de rendu performant</p>
    </div>
</div>
