{% set inputId = 'file_' ~ random() %}
{% set multiple = multiple|default(false) %}
{% set required = required|default(true) %}

<div class="mb-6">
    <label class="block text-sm font-medium text-gray-700 mb-2">
        {{ label }}
    </label>

    <div class="relative border-2 border-dashed border-gray-300 rounded-xl p-12 text-center hover:border-blue-400 transition-all bg-white"
         ondragover="event.preventDefault(); this.classList.add('border-blue-500', 'bg-blue-50')"
         ondragleave="this.classList.remove('border-blue-500', 'bg-blue-50')"
         ondrop="handleDrop(event, '{{ inputId }}'); this.classList.remove('border-blue-500', 'bg-blue-50')">

        {# Icône #}
        <div class="mb-4 flex justify-center">
            <i data-lucide="folder" class="w-16 h-16 text-blue-500"></i>
        </div>

        {# Texte #}
        <p class="text-gray-700 font-medium mb-2">
            Cliquez pour parcourir ou glissez un fichier ici
        </p>

        {# Formats acceptés #}
        <p class="text-sm text-gray-500">
            Formats acceptés : {{ formats }}
        </p>

        {# Input caché #}
        <input type="file"
               id="{{ inputId }}"
               name="{{ name }}"
               accept="{{ accept }}"
               {% if multiple %}multiple{% endif %}
                {% if required %}required{% endif %}
               class="absolute inset-0 w-full h-full opacity-0 cursor-pointer"
               onchange="displayFileName('{{ inputId }}')">
    </div>

    {# Nom du fichier sélectionné #}
    <p id="{{ inputId }}_filename" class="mt-2 text-sm text-gray-600 hidden"></p>
</div>

<script>
    function handleDrop(event, inputId) {
        event.preventDefault();
        const input = document.getElementById(inputId);
        input.files = event.dataTransfer.files;
        displayFileName(inputId);
    }

    function displayFileName(inputId) {
        const input = document.getElementById(inputId);
        const filenameDisplay = document.getElementById(inputId + '_filename');

        if (input.files.length > 0) {
            if (input.files.length === 1) {
                filenameDisplay.innerHTML = '<i data-lucide="file-check" class="w-4 h-4 inline mr-2 text-green-600"></i>' + input.files[0].name;
            } else {
                filenameDisplay.innerHTML = '<i data-lucide="files" class="w-4 h-4 inline mr-2 text-green-600"></i>' + input.files.length + ' fichiers sélectionnés';
            }
            filenameDisplay.classList.remove('hidden');
            lucide.createIcons();
        } else {
            filenameDisplay.classList.add('hidden');
        }
    }
</script>