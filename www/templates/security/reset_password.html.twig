{% extends 'base.html.twig' %}

{% block title %}Réinitialiser le mot de passe{% endblock %}

{% block body %}
    <div style="max-width: 400px; margin: 50px auto; padding: 20px; border: 1px solid #ddd; border-radius: 5px;">
        <h1>Réinitialiser le mot de passe</h1>

        {% for message in app.flashes('error') %}
            <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 3px; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        {% for message in app.flashes('success') %}
            <div style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 3px; margin-bottom: 15px;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post">
            <div style="margin-bottom: 15px;">
                <label for="password">Nouveau mot de passe :</label>
                <input type="password" id="password" name="password" required minlength="6" style="width: 100%; padding: 8px;">
                <small style="color: #666;">Au moins 6 caractères</small>
            </div>

            <div style="margin-bottom: 15px;">
                <label for="confirm_password">Confirmer le mot de passe :</label>
                <input type="password" id="confirm_password" name="confirm_password" required minlength="6" style="width: 100%; padding: 8px;">
            </div>

            <button type="submit" style="width: 100%; padding: 10px; background-color: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">
                Réinitialiser le mot de passe
            </button>

            <div style="margin-top: 15px; text-align: center;">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </form>
    </div>
{% endblock %}