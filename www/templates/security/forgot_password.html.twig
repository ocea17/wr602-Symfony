{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - PDF Generator{% endblock %}

{% block body %}
{# Header public #}
<header class="bg-white shadow-sm sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 py-3 sm:py-4">
        <div class="flex justify-between items-center">
            {# Logo #}
            <a href="{{ path('app_home_public') }}" class="flex items-center gap-2 sm:gap-3">
                <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg">
                    <i data-lucide="file-text" class="w-5 h-5 sm:w-6 sm:h-6 text-white"></i>
                </div>
                <span class="text-base sm:text-xl font-bold bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                    PDF Generator
                </span>
            </a>

            {# Navigation #}
            <div class="flex items-center gap-2 sm:gap-4">
                <a href="{{ path('app_login') }}" class="text-sm sm:text-base text-gray-700 hover:text-blue-600 font-medium transition px-3 sm:px-0">
                    Se connecter
                </a>
                <a href="{{ path('app_register') }}" class="px-4 sm:px-6 py-2 sm:py-2.5 bg-gradient-to-r from-blue-500 to-purple-600 hover:from-blue-600 hover:to-purple-700 text-white font-semibold rounded-lg sm:rounded-xl transition shadow-lg hover:shadow-xl text-sm sm:text-base">
                    <span class="hidden sm:inline">Créer un compte</span>
                    <span class="sm:hidden">Inscription</span>
                </a>
            </div>
        </div>
    </div>
</header>

{# Formulaire mot de passe oublié #}
<div class="min-h-screen bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 flex items-center justify-center p-5">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md p-8">
        {# En-tête du formulaire #}
        <div class="text-center mb-8">
            <div class="flex justify-center mb-4">
                <div class="w-12 h-12 bg-gradient-to-br from-blue-500 to-purple-600 rounded-xl flex items-center justify-center shadow-lg">
                    <i data-lucide="file-text" class="w-7 h-7 text-white"></i>
                </div>
            </div>
            <h1 class="text-2xl font-bold text-gray-900">PDF Generator</h1>
            <p class="text-sm text-gray-500 mt-1">Réinitialisez votre mot de passe</p>
        </div>

        <h2 class="text-2xl font-semibold text-center text-gray-900 mb-6">Mot de passe oublié</h2>

        {# Messages flash #}
        {% for message in app.flashes('success') %}
            <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4">
                {{ message }}
            </div>
        {% endfor %}

        <p class="text-gray-600 text-center mb-6">
            Entrez votre adresse email et nous vous enverrons un lien pour réinitialiser votre mot de passe.
        </p>

        <form method="post" data-turbo="false">
            <div class="mb-6">
                <label for="email" class="block text-sm font-medium text-gray-700 mb-2">Email</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                    placeholder="votre@email.com"
                    required
                >
            </div>

            <button
                type="submit"
                class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 px-4 rounded-lg transition duration-200 transform hover:scale-[1.02]"
            >
                Envoyer le lien
            </button>
        </form>

        <div class="text-center mt-6">
            <a href="{{ path('app_login') }}" class="text-sm text-blue-500 hover:text-blue-600 hover:underline">
                ← Retour à la connexion
            </a>
        </div>
    </div>
</div>
{% endblock %}