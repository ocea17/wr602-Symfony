{% extends 'base.html.twig' %}

{% block title %}Mon profil - PDF Generator{% endblock %}

{% block body %}
    <div class="py-6 sm:py-10">
        <div class="max-w-4xl mx-auto px-4 sm:px-6">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-900 mb-6 sm:mb-8">Mon profil</h1>

            {# Messages flash #}
            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6 text-sm sm:text-base">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6 text-sm sm:text-base">
                    {{ message }}
                </div>
            {% endfor %}

            {# Carte d'informations personnelles #}
            <div class="bg-white rounded-xl shadow-sm p-5 sm:p-8 mb-6">
                <div class="flex flex-col sm:flex-row items-center sm:items-start gap-4 sm:gap-6 mb-6">
                    {# Avatar #}
                    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full flex items-center justify-center text-white font-bold text-xl sm:text-2xl" style="background-color: {{ user.avatarColor }};">
                        {{ user.firstname|first|upper }}{{ user.lastname|first|upper }}
                    </div>

                    {# Nom et email #}
                    <div class="flex-1 text-center sm:text-left">
                        <h2 class="text-xl sm:text-2xl font-bold text-gray-900">{{ user.firstname }} {{ user.lastname }}</h2>
                        <p class="text-sm sm:text-base text-gray-600">{{ user.email }}</p>
                    </div>

                    {# Bouton modifier #}
                    <button
                            onclick="document.getElementById('editForm').classList.toggle('hidden'); document.getElementById('infoDisplay').classList.toggle('hidden');"
                            class="w-full sm:w-auto px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition text-sm sm:text-base"
                    >
                        Modifier
                    </button>
                </div>

                {# Informations détaillées #}
                <div id="infoDisplay" class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 pt-6 border-t border-gray-200">
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-500">Prénom</label>
                        <p class="text-base sm:text-lg text-gray-900 font-medium">{{ user.firstname }}</p>
                    </div>
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-500">Nom</label>
                        <p class="text-base sm:text-lg text-gray-900 font-medium">{{ user.lastname }}</p>
                    </div>
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-500">Email</label>
                        <p class="text-base sm:text-lg text-gray-900 font-medium break-all">{{ user.email }}</p>
                    </div>
                    <div>
                        <label class="text-xs sm:text-sm font-medium text-gray-500">Plan actuel</label>
                        <p class="text-base sm:text-lg mt-1">
                            <span class="inline-block px-3 py-1 rounded-md text-sm sm:text-base font-semibold
                                {% if user.plan.name == 'FREE' %}bg-gray-100 text-gray-700
                                {% elseif user.plan.name == 'BASIC' %}bg-blue-100 text-blue-600
                                {% else %}bg-purple-100 text-purple-600{% endif %}">
                                {{ user.plan.name }}
                            </span>
                        </p>
                    </div>
                </div>

                {# Formulaire de modification #}
                <form id="editForm" method="post" action="{{ path('app_profile_update_info') }}" class="hidden pt-6 border-t border-gray-200" data-turbo="false">
                    {# Nom et Prénom #}
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6 mb-6">
                        <div>
                            <label for="firstname" class="block text-sm font-medium text-gray-700 mb-2">Prénom</label>
                            <input type="text" id="firstname" name="firstname" value="{{ user.firstname }}" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base" required>
                        </div>
                        <div>
                            <label for="lastname" class="block text-sm font-medium text-gray-700 mb-2">Nom</label>
                            <input type="text" id="lastname" name="lastname" value="{{ user.lastname }}" class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm sm:text-base" required>
                        </div>
                    </div>

                    {# Changement de mot de passe #}
                    <div class="mb-6 p-4 bg-gray-50 rounded-lg">
                        <h4 class="text-sm font-semibold text-gray-700 mb-4">Changer mon mot de passe (optionnel)</h4>
                        <div class="space-y-4 sm:space-y-0 sm:grid sm:grid-cols-3 sm:gap-4">
                            <div>
                                <label for="current_password" class="block text-sm font-medium text-gray-700 mb-2">Mot de passe actuel</label>
                                <input type="password" id="current_password" name="current_password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" placeholder="••••••••">
                            </div>
                            <div>
                                <label for="new_password" class="block text-sm font-medium text-gray-700 mb-2">Nouveau mot de passe</label>
                                <input type="password" id="new_password" name="new_password" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" placeholder="••••••••">
                                <p class="text-xs text-gray-500 mt-1">Min. 6 caractères</p>
                            </div>
                            <div>
                                <label for="new_password_confirm" class="block text-sm font-medium text-gray-700 mb-2">Confirmer</label>
                                <input type="password" id="new_password_confirm" name="new_password_confirm" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm" placeholder="••••••••">
                            </div>
                        </div>
                    </div>

                    {# Boutons #}
                    <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                        <button type="submit" class="w-full sm:w-auto px-6 py-3 bg-blue-700 hover:bg-blue-800 text-white font-semibold rounded-lg transition text-sm sm:text-base">
                            Enregistrer les modifications
                        </button>
                        <button type="button" onclick="document.getElementById('editForm').classList.add('hidden'); document.getElementById('infoDisplay').classList.remove('hidden');" class="w-full sm:w-auto px-6 py-3 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded-lg transition text-sm sm:text-base">
                            Annuler
                        </button>
                    </div>
                </form>
            </div>

            {# Stats grid #}
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 mb-6 sm:mb-10">
                <div class="bg-blue-100 p-5 sm:p-6 rounded-xl shadow-sm">
                    <div class="text-3xl sm:text-4xl font-bold {{ today_pdfs >= (app.user.plan.limitGeneration ?? 999) ? 'text-red-500' : 'text-blue-500' }} mb-2">
                        {{ today_pdfs }}/{{ app.user.plan.limitGeneration }}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600">PDFs aujourd'hui</div>
                </div>

                <div class="bg-purple-100 p-5 sm:p-6 rounded-xl shadow-sm">
                    <div class="text-3xl sm:text-4xl font-bold text-purple-500 mb-2">
                        {{ total_pdfs }}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600">Total générés</div>
                </div>

                <a href="{{ path('app_history') }}" class="text-green-700 p-5 sm:p-6 bg-green-100 rounded-lg hover:bg-green-200 transition block">
                    <div class="text-3xl sm:text-4xl font-bold mb-2 {{ stored_pdfs >= (app.user.plan.limitStorage ?? 999) ? 'text-red-500' : 'text-green-700' }}">
                        {% if app.user.plan.limitStorage %}
                            {{ stored_pdfs }}/{{ app.user.plan.limitStorage }}
                        {% else %}
                            {{ stored_pdfs }}
                        {% endif %}
                    </div>
                    <div class="text-xs sm:text-sm text-gray-600">PDFs stockés</div>
                </a>
            </div>

            {# Couleurs #}
            <div class="bg-white rounded-xl shadow-sm p-5 sm:p-8 mb-6">
                <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4 sm:mb-6">Personnalisation</h3>
                <form method="post" action="{{ path('app_profile_update_color') }}" data-turbo="false">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-3">Couleur de l'avatar</label>
                        <div class="flex items-center gap-3 sm:gap-4 flex-wrap">
                            {% set colors = ['#3264FB', '#8B5CF6', '#EC4899', '#10B981', '#F59E0B', '#EF4444', '#6366F1', '#14B8A6'] %}
                            {% for color in colors %}
                                <button type="submit" name="color" value="{{ color }}" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full border-4 {{ app.user.avatarColor == color ? 'border-gray-900' : 'border-gray-200' }} hover:border-gray-400 transition" style="background-color: {{ color }};"></button>
                            {% endfor %}
                        </div>
                    </div>
                </form>
            </div>

            {# Actions #}
            <div class="bg-white rounded-xl shadow-sm p-5 sm:p-8">
                <h3 class="text-lg sm:text-xl font-semibold text-gray-900 mb-4 sm:mb-6">Actions rapides</h3>
                <div class="space-y-3 sm:space-y-4">
                    <a href="{{ path('app_subscription_change') }}" class="flex items-center justify-between p-4 border border-purple-400 rounded-lg hover:border-purple-500 hover:bg-purple-50 transition group">
                        <div>
                            <div class="font-semibold text-gray-900 group-hover:text-purple-500 text-sm sm:text-base">Changer d'abonnement</div>
                            <div class="text-xs sm:text-sm text-gray-600">Découvrir les plans disponibles</div>
                        </div>
                        <svg class="w-5 h-5 fill-none text-gray-400 group-hover:text-purple-500" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>

                    <a href="{{ path('app_history') }}" class="flex items-center justify-between p-4 border border-blue-400 rounded-lg hover:border-blue-500 hover:bg-blue-50 transition group">
                        <div>
                            <div class="font-semibold text-gray-900 group-hover:text-blue-500 text-sm sm:text-base">Voir mon historique</div>
                            <div class="text-xs sm:text-sm text-gray-600">Accéder à tous mes PDFs</div>
                        </div>
                        <svg class="w-5 h-5 fill-none text-gray-400 group-hover:text-blue-500" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                        </svg>
                    </a>

                    <a href="{{ path('app_logout') }}" class="flex items-center justify-between p-4 border border-red-500 rounded-lg hover:border-red-700 hover:bg-red-50 transition group">
                        <div>
                            <div class="font-semibold text-gray-900 group-hover:text-red-500 text-sm sm:text-base">Se déconnecter</div>
                            <div class="text-xs sm:text-sm text-gray-600">Fermer ma session</div>
                        </div>
                    </a>
                </div>
            </div>

            {# Retour #}
            <div class="text-center mt-6 sm:mt-8">
                <a href="{{ path('app_home') }}" class="text-blue-600 hover:text-blue-700 font-medium hover:underline text-sm sm:text-base">
                    ← Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}