{% extends 'base.html.twig' %}

{% block title %}Historique - PDF Generator{% endblock %}

{% block body %}
    {% set hasAccess = is_granted('CONTACT_VIEW') %}

    {# Overlay modal pour free #}
    {% if not hasAccess %}
        <div class="fixed top-20 left-0 right-0 bottom-16 bg-gray-900 bg-opacity-70 backdrop-blur-[2px] z-[100] flex items-center justify-center px-4">
            <div class="bg-white rounded-xl shadow-2xl p-8 max-w-md mx-auto text-center">
                <div class="mb-4">
                    <i data-lucide="lock" class="w-16 h-16 text-blue-500 mx-auto"></i>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 mb-4">Fonctionnalité BASIC</h2>
                <p class="text-gray-600 mb-6">
                    Consultez votre historique avec un abonnement <strong>BASIC</strong> ou <strong>PREMIUM</strong>
                </p>
                <a href="{{ path('app_subscription_change') }}" class="inline-block py-3 px-8 bg-blue-500 hover:bg-blue-600 text-white font-semibold rounded-lg transition transform hover:scale-105">
                    Améliorer mon plan
                </a>
            </div>
        </div>
    {% endif %}

    {# Contenu flouté #}
    <div class="py-6 sm:py-10 {% if not hasAccess %}filter blur-[1px] pointer-events-none select-none{% endif %}">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-6 sm:mb-8">Mes générations</h1>

            {# Messages flash #}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% if generations|length > 0 %}
                {# Stats #}
                <div class="bg-white rounded-xl shadow-sm p-4 sm:p-6 mb-6 sm:mb-8">
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
                        <div>
                            <p class="text-sm sm:text-base text-gray-700">
                                Stockage utilisé :
                                <strong class="{{ generations|length >= (app.user.plan.limitStorage ?? 999) ? 'text-red-500' : 'text-blue-600' }}">
                                    {{ generations|length }}{% if app.user.plan.limitStorage %}/{{ app.user.plan.limitStorage }}{% endif %}
                                </strong>
                                PDF(s)
                            </p>
                        </div>
                        {% if app.user.plan.limitStorage %}
                            <div class="text-xs sm:text-sm text-gray-500">
                                Limite : {{ app.user.plan.limitStorage }} PDFs
                            </div>
                        {% endif %}
                    </div>

                    {# Message d'information #}
                    <div class="bg-blue-50 border-l-4 border-blue-500 p-3 sm:p-4 rounded">
                        <div class="flex items-start gap-2 sm:gap-3">
                            <i data-lucide="info" class="w-4 h-4 sm:w-5 sm:h-5 text-blue-500 mt-0.5 flex-shrink-0"></i>
                            <div class="text-xs sm:text-sm text-gray-700">
                                <p class="font-semibold text-blue-900 mb-1">Gestion automatique du stockage</p>
                                <p>Lorsque la limite est atteinte, les documents les plus anciens sont automatiquement supprimés. Vous avez également la possibilité de supprimer manuellement des documents afin de libérer de l'espace de stockage.</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# Desktop: tableau - mobile: cards #}
                <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                    {# Desktop: tableau - mobile: caché #}
                    <div class="hidden md:block">
                        <table class="w-full">
                            <thead class="bg-gray-100 border-b border-gray-200">
                            <tr>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Type</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Nom</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Date</th>
                                <th class="px-6 py-4 text-left text-sm font-semibold text-gray-900">Actions</th>
                            </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                            {% for generation in generations %}
                                <tr>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center gap-2">
                                            {% if generation.type == 'url' %}
                                                <i data-lucide="globe" class="w-4 h-4 text-blue-500"></i>
                                                <span class="text-sm text-gray-900">URL vers PDF</span>
                                            {% elseif generation.type == 'html' %}
                                                <i data-lucide="file-text" class="w-4 h-4 text-green-500"></i>
                                                <span class="text-sm text-gray-900">Fichier HTML</span>
                                            {% elseif generation.type == 'wysiwyg' %}
                                                <i data-lucide="pencil" class="w-4 h-4 text-purple-500"></i>
                                                <span class="text-sm text-gray-900">Éditeur WYSIWYG</span>
                                            {% elseif generation.type == 'merge' %}
                                                <i data-lucide="git-merge" class="w-4 h-4 text-blue-500"></i>
                                                <span class="text-sm text-gray-900">Fusion de PDFs</span>
                                            {% elseif generation.type == 'split' %}
                                                <i data-lucide="scissors" class="w-4 h-4 text-red-500"></i>
                                                <span class="text-sm text-gray-900">Séparation PDF</span>
                                            {% elseif generation.type == 'screenshot' %}
                                                <i data-lucide="camera" class="w-4 h-4 text-pink-500"></i>
                                                <span class="text-sm text-gray-900">Image vers PDF</span>
                                            {% elseif generation.type == 'office' %}
                                                <i data-lucide="file-text" class="w-4 h-4 text-blue-500"></i>
                                                <span class="text-sm text-gray-900">Office vers PDF</span>
                                            {% elseif generation.type == 'text' %}
                                                <i data-lucide="file-type" class="w-4 h-4 text-gray-500"></i>
                                                <span class="text-sm text-gray-900">Texte vers PDF</span>
                                            {% else %}
                                                <i data-lucide="file" class="w-4 h-4 text-gray-500"></i>
                                                <span class="text-sm text-gray-900">Génération PDF</span>
                                            {% endif %}
                                        </div>
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                                        {{ generation.customName ?? generation.file|split('/')|last }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600">
                                        {{ generation.createdAt|date('d/m/Y à H:i') }}
                                    </td>
                                    <td class="px-6 py-4 whitespace-nowrap">
                                        <div class="flex items-center gap-2">
                                            <a href="{{ asset(generation.file) }}" target="_blank" 
                                               class="inline-flex items-center gap-2 px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg transition text-sm"
                                               title="Voir">
                                                <i data-lucide="eye" class="w-4 h-4"></i>
                                            </a>
                                            <button onclick="openSendModal({{ generation.id }}, '{{ generation.customName ?? generation.file|split('/')|last }}')" 
                                                    class="inline-flex items-center gap-2 px-3 py-2 bg-purple-500 hover:bg-purple-600 text-white rounded-lg transition text-sm"
                                                    title="Envoyer">
                                                <i data-lucide="send" class="w-4 h-4"></i>
                                            </button>
                                            <a href="{{ asset(generation.file) }}" download 
                                               class="inline-flex items-center gap-2 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition text-sm"
                                               title="Télécharger">
                                                <i data-lucide="download" class="w-4 h-4"></i>
                                            </a>
                                            <form method="post" action="{{ path('app_history_delete', {id: generation.id}) }}" 
                                                  class="inline" 
                                                  onsubmit="return confirm('Voulez-vous vraiment supprimer ce PDF ?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ generation.id) }}">
                                                <button type="submit" 
                                                        class="inline-flex items-center gap-2 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition text-sm"
                                                        title="Supprimer">
                                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    {# Mobile: cards - desktop: caché #}
                    <div class="md:hidden divide-y divide-gray-200">
                        {% for generation in generations %}
                            <div class="p-4 hover:bg-gray-50 transition">
                                {# Header #}
                                <div class="flex items-start justify-between mb-3">
                                    <div class="flex items-center gap-2">
                                        {% if generation.type == 'url' %}
                                            <i data-lucide="globe" class="w-5 h-5 text-blue-500"></i>
                                        {% elseif generation.type == 'html' %}
                                            <i data-lucide="file-text" class="w-5 h-5 text-green-500"></i>
                                        {% elseif generation.type == 'wysiwyg' %}
                                            <i data-lucide="pencil" class="w-5 h-5 text-purple-500"></i>
                                        {% elseif generation.type == 'merge' %}
                                            <i data-lucide="git-merge" class="w-5 h-5 text-blue-500"></i>
                                        {% elseif generation.type == 'split' %}
                                            <i data-lucide="scissors" class="w-5 h-5 text-red-500"></i>
                                        {% elseif generation.type == 'screenshot' %}
                                            <i data-lucide="camera" class="w-5 h-5 text-pink-500"></i>
                                        {% elseif generation.type == 'office' %}
                                            <i data-lucide="file-text" class="w-5 h-5 text-blue-500"></i>
                                        {% elseif generation.type == 'text' %}
                                            <i data-lucide="file-type" class="w-5 h-5 text-gray-500"></i>
                                        {% else %}
                                            <i data-lucide="file" class="w-5 h-5 text-gray-500"></i>
                                        {% endif %}
                                        <span class="text-xs text-gray-500 uppercase">{{ generation.type }}</span>
                                    </div>
                                    <span class="text-xs text-gray-500">{{ generation.createdAt|date('d/m/Y') }}</span>
                                </div>

                                {# Filename #}
                                <p class="font-medium text-gray-900 mb-3 text-sm">
                                    {{ generation.customName ?? generation.file|split('/')|last }}
                                </p>

                                {# Actions grid #}
                                <div class="grid grid-cols-2 gap-2">
                                    <a href="{{ asset(generation.file) }}" target="_blank" 
                                       class="flex items-center justify-center gap-2 px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded-lg transition text-sm">
                                        <i data-lucide="eye" class="w-4 h-4"></i>
                                        <span>Voir</span>
                                    </a>
                                    <button onclick="openSendModal({{ generation.id }}, '{{ generation.customName ?? generation.file|split('/')|last }}')" 
                                            class="flex items-center justify-center gap-2 px-3 py-2 bg-purple-500 hover:bg-purple-600 text-white rounded-lg transition text-sm">
                                        <i data-lucide="send" class="w-4 h-4"></i>
                                        <span>Envoyer</span>
                                    </button>
                                    <a href="{{ asset(generation.file) }}" download 
                                       class="flex items-center justify-center gap-2 px-3 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition text-sm">
                                        <i data-lucide="download" class="w-4 h-4"></i>
                                        <span>Télécharger</span>
                                    </a>
                                    <form method="post" action="{{ path('app_history_delete', {id: generation.id}) }}" 
                                          onsubmit="return confirm('Voulez-vous vraiment supprimer ce PDF ?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ generation.id) }}">
                                        <button type="submit" 
                                                class="w-full flex items-center justify-center gap-2 px-3 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg transition text-sm">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            <span>Supprimer</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# Pagination #}
                {% if totalPages > 1 %}
                    <div class="flex justify-center items-center gap-2 mt-6 sm:mt-8">
                        {% if currentPage > 1 %}
                            <a href="{{ path('app_history', {page: currentPage - 1}) }}" 
                               class="px-3 sm:px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition text-sm">
                                ← Précédent
                            </a>
                        {% endif %}
                        <span class="px-3 sm:px-4 py-2 text-gray-600 text-sm">
                            Page {{ currentPage }} sur {{ totalPages }}
                        </span>
                        {% if currentPage < totalPages %}
                            <a href="{{ path('app_history', {page: currentPage + 1}) }}" 
                               class="px-3 sm:px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition text-sm">
                                Suivant →
                            </a>
                        {% endif %}
                    </div>
                {% endif %}
            {% else %}
                {# Lorsque le tableau est vide #}
                <div class="bg-white rounded-xl shadow-sm p-8 sm:p-16 text-center">
                    <div class="flex justify-center mb-4">
                        <i data-lucide="file-text" class="w-12 h-12 sm:w-16 sm:h-16 text-gray-400"></i>
                    </div>
                    <h2 class="text-xl sm:text-2xl font-semibold text-gray-900 mb-2">Aucune génération pour le moment</h2>
                    <p class="text-sm sm:text-base text-gray-600 mb-6">Vous n'avez pas encore généré de PDF</p>
                    <a href="{{ path('app_pdf_index') }}" 
                       class="inline-flex items-center gap-2 px-4 sm:px-6 py-2 sm:py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition font-semibold text-sm sm:text-base">
                        Générer mon premier PDF
                    </a>
                </div>
            {% endif %}

            {# Retour #}
            <div class="text-center mt-6 sm:mt-8">
                <a href="{{ path('app_home') }}" 
                   class="text-sm sm:text-base text-blue-600 hover:text-blue-700 font-medium hover:underline">
                    ← Retour à l'accueil
                </a>
            </div>
        </div>
    </div>

    {# Modal d'envoi #}
    <div id="sendModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 z-[9999] flex items-center justify-center px-4">
        <div class="bg-white rounded-xl shadow-2xl p-6 sm:p-8 max-w-2xl w-full max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Envoyer le PDF</h2>
                <button onclick="closeSendModal()" class="text-gray-400 hover:text-gray-600">
                    <i data-lucide="x" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                </button>
            </div>

            <p class="text-sm sm:text-base text-gray-600 mb-6">
                Fichier : <strong id="modalFileName"></strong>
            </p>

            <form id="sendPdfForm" method="post" action="">
                <input type="hidden" name="_token" value="{{ csrf_token('send_pdf') }}">

                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Sélectionnez les destinataires
                    </label>

                    {% if contacts|length > 0 %}
                        <div class="space-y-2 max-h-48 sm:max-h-64 overflow-y-auto border border-gray-200 rounded-lg p-3 sm:p-4">
                            {% for contact in contacts %}
                                <label class="flex items-center gap-2 sm:gap-3 p-2 hover:bg-gray-50 rounded cursor-pointer">
                                    <input type="checkbox" name="contacts[]" value="{{ contact.id }}" 
                                           class="w-4 h-4 text-blue-500 rounded flex-shrink-0">
                                    <div class="flex-1 min-w-0">
                                        <span class="text-sm sm:text-base text-gray-900 block truncate">
                                            {{ contact.firstname }} {{ contact.lastname }}
                                        </span>
                                        <span class="text-xs sm:text-sm text-gray-500 block truncate">
                                            {{ contact.email }}
                                        </span>
                                    </div>
                                </label>
                            {% endfor %}
                        </div>

                        {# Lien pour ajouter un contact (même s'il y en a) #}
                        <div class="mt-3 text-center">
                            <a href="{{ path('app_contacts_new', {redirect: 'app_history'}) }}" 
                               class="text-blue-600 hover:underline text-xs sm:text-sm inline-flex items-center gap-1">
                                <i data-lucide="plus" class="w-3 h-3 sm:w-4 sm:h-4"></i>
                                Ajouter un nouveau contact
                            </a>
                        </div>
                    {% else %}
                        <div class="text-center py-6 border border-gray-200 rounded-lg">
                            <p class="text-sm sm:text-base text-gray-600 mb-4">Aucun contact disponible.</p>
                            <a href="{{ path('app_contacts_new', {redirect: 'app_history'}) }}" 
                               class="inline-flex items-center gap-2 px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition text-sm">
                                <i data-lucide="plus" class="w-4 h-4"></i>
                                Ajouter un contact
                            </a>
                        </div>                    
                    {% endif %}
                </div>

                <div class="mb-6">
                    <label for="messageInput" class="block text-sm font-medium text-gray-700 mb-2">
                        Message personnalisé (optionnel)
                    </label>
                    <textarea id="messageInput" name="message" rows="4" 
                              class="w-full border border-gray-300 rounded-lg p-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm sm:text-base" 
                              placeholder="Ajoutez un message..."></textarea>
                </div>

                <div class="flex flex-col-reverse sm:flex-row justify-end gap-3">
                    <button type="button" onclick="closeSendModal()" 
                            class="w-full sm:w-auto px-4 sm:px-6 py-2 border border-gray-300 rounded-lg hover:bg-gray-50 transition text-sm sm:text-base">
                        Annuler
                    </button>
                    <button type="submit" 
                            class="w-full sm:w-auto px-4 sm:px-6 py-2 bg-purple-500 hover:bg-purple-600 text-white rounded-lg transition text-sm sm:text-base">
                        Envoyer
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openSendModal(generationId, fileName) {
            document.getElementById('sendModal').classList.remove('hidden');
            document.getElementById('modalFileName').textContent = fileName;
            document.getElementById('sendPdfForm').action = '/history/send/' + generationId;
            lucide.createIcons();
        }

        function closeSendModal() {
            document.getElementById('sendModal').classList.add('hidden');
        }
    </script>
{% endblock %}
