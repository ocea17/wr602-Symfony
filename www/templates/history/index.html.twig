{% extends 'base.html.twig' %}

{% block title %}Historique - PDF Generator{% endblock %}

{% block body %}
    {# Header #}
    {{ include('_partials/header.html.twig') }}

    <div class="min-h-screen bg-gray-50 py-10">
        <div class="max-w-7xl mx-auto px-6">
            <h1 class="text-4xl font-bold text-gray-900 mb-8">Mes générations</h1>

            {# Messages flash #}
            {% for message in app.flashes('error') %}
                <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-6">
                    {{ message }}
                </div>
            {% endfor %}

            {% if generations|length > 0 %}
                {# Stats rapides #}
                <div class="bg-white rounded-xl shadow-sm p-6 mb-8">
                    <p class="text-gray-700">
                        Total : <strong class="text-blue-500">{{ generations|length }}</strong> PDF(s) généré(s)
                    </p>
                </div>

                {# Table des PDFs #}
                <div class="bg-white rounded-xl shadow-sm overflow-hidden">
                    {# Header du tableau #}
                    <div class="grid grid-cols-12 gap-4 px-6 py-4 bg-gray-50 border-b border-gray-200 font-semibold text-sm text-gray-600 uppercase">
                        <div class="col-span-1"></div>
                        <div class="col-span-5">Nom</div>
                        <div class="col-span-3">Date</div>
                        <div class="col-span-3 text-center">Actions</div>
                    </div>

                    {# Liste des PDFs #}
                    {% for generation in generations %}
                        <div class="grid grid-cols-12 gap-4 px-6 py-5 border-b border-gray-200 hover:bg-gray-50 transition items-center">
                            {# Icône #}
                            <div class="col-span-1 text-3xl">
                                📄
                            </div>

                            {# Nom du fichier #}
                            <div class="col-span-5">
                            <span class="font-medium text-gray-900">
                                {{ generation.file|split('/')|last }}
                            </span>
                            </div>

                            {# Date #}
                            <div class="col-span-3 text-sm text-gray-600">
                                {{ generation.createdAt|date('d/m/Y à H:i') }}
                            </div>

                            {# Actions #}
                            <div class="col-span-3 text-center">
                                <a
                                        href="{{ path('app_history_download', {id: generation.id}) }}"
                                        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition font-medium text-sm"
                                >
                                    Télécharger
                                </a>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% else %}
                {# État vide #}
                <div class="bg-white rounded-xl shadow-sm p-16 text-center">
                    <div class="text-6xl mb-4 opacity-50">📄</div>
                    <h2 class="text-2xl font-semibold text-gray-900 mb-2">Aucune génération pour le moment</h2>
                    <p class="text-gray-600 mb-6">Vous n'avez pas encore généré de PDF</p>
                    <a
                            href="{{ path('app_pdf_index') }}"
                            class="inline-flex items-center gap-2 px-6 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg transition font-semibold"
                    >
                        Générer mon premier PDF
                    </a>
                </div>
            {% endif %}

            {# Retour #}
            <div class="text-center mt-8">
                <a href="{{ path('app_home') }}" class="text-blue-500 hover:text-blue-600 font-medium hover:underline">
                    ← Retour à l'accueil
                </a>
            </div>
        </div>
    </div>
{% endblock %}